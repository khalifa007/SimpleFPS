+float estimate_text_width(const char* text, int font_size) {
+    /* The font is proportional and cannot be measured here: per-glyph guesses. */
+    float units = 0.0f;
+    for (; text && *text; ++text) {
+        const char c = *text;
+        if (c >= '0' && c <= '9')
+            units += 0.60f;
+        else if (c >= 'A' && c <= 'Z')
+            units += 0.70f;
+        else if (c == '.' || c == ':' || c == ' ')
+            units += 0.30f;
+        else if (c == '-')
+            units += 0.40f;
+        else
+            units += 0.60f;
+    }
+    return units * static_cast<float>(font_size);
+}
